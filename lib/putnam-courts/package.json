{
  "name": "Putnam County Court Connector",
  "description": "Connector for accessing Putnam County, Tennessee public court records and docket information through open government APIs and judicial portals. Provides structured access to Tennessee court cases, docket entries, and case outcomes.",
  "main": "./src/index.ts",
  "scripts": {
    "validate": "jest ./tests/putnam-county-court/validation.test.ts",
    "build": "tsc -p ./tsconfig.build.json",
    "test": "npm run validate",
    "build:connectors": "tsc -p ./tsconfig.build.json"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^18.2.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.11.27",
    "@types/cheerio": "^0.22.2",
    "@types/node-fetch": "^2.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "Tennessee",
    "Putnam County",
    "court-records",
    "public-data",
    "open-data",
    "connector",
    "jurisdiction"
  ],
  "author": "Akashic",
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "cjs"
    ],
    "testRegex": "(/|\\\\.|\\\\.)(test|spec)?(.ts|.js|cjs)$",
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "!src/**/*.d.ts"
    ]
  }
}